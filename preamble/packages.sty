\setotherlanguages{german,english,spanish}

% --- Fonts (Cyrillic-capable; fallbacks guaranteed in TeX Live) -------
\setmainfont{Liberation Serif}[
  Scale     = 1.00 ,
  Ligatures = TeX ]
\setsansfont{Liberation Sans}[Scale = 0.95, Ligatures = TeX]
\setmonofont{Liberation Mono}[Scale = 0.90]

% --- Geometry: pocket-brochure feel, wide outer margin ---------------
\usepackage[
  paperwidth  = 148mm ,
  paperheight = 210mm ,
  inner       = 14mm  ,
  outer       = 36mm  ,
  top         = 16mm  ,
  bottom      = 18mm  ,
  marginparwidth = 28mm ,
  marginparsep   = 3mm
]{geometry}

